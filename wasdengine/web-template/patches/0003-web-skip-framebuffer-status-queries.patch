@@ -39,3 +39,12 @@
 #define eglGetProcAddress(n) static_assert(false, "Usage of eglGetProcessAddress() on the web is a bug.")
 
 #include "platform/web/godot_webgl2.h" // IWYU pragma: export.
+
+#ifndef DEBUG_ENABLED
+// A release build reports every framebuffer as complete without asking WebGL. The browser answers
+// checkFramebufferStatus() only after its GPU process has run every command queued before the call, so each query
+// blocks the main thread behind pending texture uploads and shader compiles. The Compatibility renderer uses the
+// answer to print an error and drop the framebuffer, except where it falls back; those callers write
+// (glCheckFramebufferStatus)(...), which this function-like macro leaves alone.
+#define glCheckFramebufferStatus(m_target) ((GLenum)GL_FRAMEBUFFER_COMPLETE)
+#endif
