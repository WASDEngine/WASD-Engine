 void ParticlesStorage::particles_emit(RID p_particles, const Transform3D &p_transform, const Vector3 &p_velocity, const Color &p_color, const Color &p_custom, uint32_t p_emit_flags) {
-	WARN_PRINT_ONCE_ED("The Compatibility renderer does not support manually emitting particles.");
+	Particles *particles = particles_owner.get_or_null(p_particles);
+	ERR_FAIL_NULL(particles);
+	ERR_FAIL_COND(particles->amount == 0);
+
+	// As in the RenderingDevice renderers, emitting by hand ends the system's own emission.
+	if (particles->emitting) {
+		particles->clear = true;
+		particles->emitting = false;
+	}
+
+	particles->inactive = false;
+	particles->inactive_time = 0;
+
+	if (particles->emissions.size() < uint32_t(particles->amount)) {
+		Particles::Emission emission;
+		emission.transform = p_transform;
+		emission.velocity = p_velocity;
+		emission.color = p_color;
+		emission.custom = p_custom;
+		emission.flags = p_emit_flags;
+		particles->emissions.push_back(emission);
+	}
+}
+
+// Bits of a particle's flags that drivers/gles3/shaders/particles.glsl reads as PARTICLE_FLAG_EMITTED and
+// PARTICLE_EMISSION_SHIFT.
+static constexpr uint32_t PARTICLE_FLAG_EMITTED = 8;
+static constexpr uint32_t PARTICLE_EMISSION_SHIFT = 8;
+
+void ParticlesStorage::_particles_write_emissions(Particles *p_particles) {
+	if (p_particles->emissions.is_empty() || p_particles->amount <= 0 || p_particles->back_process_buffer == 0) {
+		return;
+	}
+
+	// Each request overwrites the color, velocity and flags, custom data, and transform rows of one particle in the
+	// buffer that the process step reads, and flags it PARTICLE_FLAG_EMITTED; the process shader then starts that
+	// particle from the supplied values, as the RenderingDevice renderers start an inactive particle from their
+	// emission buffer. This renderer has no atomics to find inactive particles, so requests take the slots in turn:
+	// a request restarts the particle of the request `amount` before it, even when that one is still active.
+	const uint32_t rows = p_particles->mode == RSE::PARTICLES_MODE_2D ? 2 : 3;
+	const uint32_t amount = uint32_t(p_particles->amount);
+	const uint32_t count = MIN(p_particles->emissions.size(), amount);
+	float data[4 * 6];
+
+	glBindBuffer(GL_ARRAY_BUFFER, p_particles->back_process_buffer);
+	for (uint32_t i = 0; i < count; i++) {
+		const Particles::Emission &emission = p_particles->emissions[i];
+		data[0] = emission.color.r;
+		data[1] = emission.color.g;
+		data[2] = emission.color.b;
+		data[3] = emission.color.a;
+		data[4] = emission.velocity.x;
+		data[5] = emission.velocity.y;
+		data[6] = emission.velocity.z;
+		const uint32_t flags = PARTICLE_FLAG_EMITTED | (emission.flags << PARTICLE_EMISSION_SHIFT);
+		memcpy(&data[7], &flags, sizeof(flags));
+		data[8] = emission.custom.r;
+		data[9] = emission.custom.g;
+		data[10] = emission.custom.b;
+		data[11] = emission.custom.a;
+		for (uint32_t row = 0; row < rows; row++) {
+			data[12 + row * 4 + 0] = emission.transform.basis.rows[row][0];
+			data[12 + row * 4 + 1] = emission.transform.basis.rows[row][1];
+			data[12 + row * 4 + 2] = emission.transform.basis.rows[row][2];
+			data[12 + row * 4 + 3] = emission.transform.origin[row];
+		}
+		const uint32_t slot = p_particles->emission_slot % amount;
+		glBufferSubData(GL_ARRAY_BUFFER, slot * p_particles->process_buffer_stride_cache, sizeof(float) * 4 * (3 + rows), data);
+		p_particles->emission_slot = slot + 1;
+	}
+	glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+	p_particles->emissions.clear();
 }
 
