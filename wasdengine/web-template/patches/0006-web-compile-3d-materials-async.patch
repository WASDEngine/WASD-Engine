+void ShaderGLES3::_start_specialization(Version::Specialization &spec, uint32_t p_variant, Version *p_version, uint64_t p_specialization) {
+	// Queue both compiles and the link without asking for their status, which would wait for the driver.
+	spec.id = glCreateProgram();
+	spec.ok = false;
+	for (int stage = 0; stage < 2; stage++) {
+		StringBuilder builder;
+		_build_variant_code(builder, p_variant, p_version, stage == 0 ? STAGE_TYPE_VERTEX : STAGE_TYPE_FRAGMENT, p_specialization);
+		CharString cs = builder.as_string().utf8();
+		const char *cstr = cs.ptr();
+		GLint cstr_len = cs.length();
+		GLuint shader_id = glCreateShader(stage == 0 ? GL_VERTEX_SHADER : GL_FRAGMENT_SHADER);
+		glShaderSource(shader_id, 1, &cstr, &cstr_len);
+		glCompileShader(shader_id);
+		glAttachShader(spec.id, shader_id);
+		(stage == 0 ? spec.vert_id : spec.frag_id) = shader_id;
+	}
+
+	if (feedback_count) {
+		Vector<const char *> feedback;
+		for (int i = 0; i < feedback_count; i++) {
+			if (feedbacks[i].specialization == 0 || (feedbacks[i].specialization & p_specialization)) {
+				feedback.push_back(feedbacks[i].name);
+			}
+		}
+		if (feedback.size()) {
+			glTransformFeedbackVaryings(spec.id, feedback.size(), feedback.ptr(), GL_INTERLEAVED_ATTRIBS);
+		}
+	}
+
+	glLinkProgram(spec.id);
+}
+
+void ShaderGLES3::_finish_specialization(Version::Specialization &spec, uint32_t p_variant, Version *p_version, uint64_t p_specialization) {
+	GLint status = GL_FALSE;
+	glGetProgramiv(spec.id, GL_LINK_STATUS, &status);
+	if (status == GL_FALSE) {
+		// Report the stage that did not compile, with its code, or else the link log.
+		String error;
+		String code;
+		for (int stage = 0; stage < 2 && error.is_empty(); stage++) {
+			GLuint shader_id = stage == 0 ? spec.vert_id : spec.frag_id;
+			GLint compiled = GL_FALSE;
+			glGetShaderiv(shader_id, GL_COMPILE_STATUS, &compiled);
+			if (compiled == GL_FALSE) {
+				GLint length = 0;
+				glGetShaderiv(shader_id, GL_INFO_LOG_LENGTH, &length);
+				CharString log;
+				log.resize_uninitialized(MAX(length, 1));
+				glGetShaderInfoLog(shader_id, MAX(length, 1), nullptr, log.ptrw());
+				error = name + (stage == 0 ? ": Vertex" : ": Fragment") + " shader compilation failed:\n" + String::utf8(log.get_data());
+				StringBuilder builder;
+				_build_variant_code(builder, p_variant, p_version, stage == 0 ? STAGE_TYPE_VERTEX : STAGE_TYPE_FRAGMENT, p_specialization);
+				code = builder.as_string();
+			}
+		}
+		if (error.is_empty()) {
+			GLint length = 0;
+			glGetProgramiv(spec.id, GL_INFO_LOG_LENGTH, &length);
+			CharString log;
+			log.resize_uninitialized(MAX(length, 1));
+			glGetProgramInfoLog(spec.id, MAX(length, 1), nullptr, log.ptrw());
+			error = name + ": Program linking failed:\n" + String::utf8(log.get_data());
+		}
+		_display_error_with_code(error, code);
+		glDeleteShader(spec.vert_id);
+		glDeleteShader(spec.frag_id);
+		glDeleteProgram(spec.id);
+		spec.id = 0;
+		return;
+	}
+
+	_get_uniform_locations(spec, p_version);
+	spec.ok = true;
+}
+
+ShaderGLES3::Version::Specialization *ShaderGLES3::_get_async_specialization(Version *p_version, int p_variant, uint64_t p_specialization) {
+	Version::Specialization *spec = p_version->variants[p_variant].getptr(p_specialization);
+	if (!spec) {
+		Version::Specialization started;
+		_start_specialization(started, p_variant, p_version, p_specialization);
+		started.build_queued = true;
+		p_version->variants[p_variant].insert(p_specialization, started);
+		spec = p_version->variants[p_variant].getptr(p_specialization);
+	}
+	// A completion query never waits: draws skip the program until the browser's compiler threads finish it, so
+	// programs that several draws need compile at the same time instead of one after another on the main thread.
+	GLint done = GL_FALSE;
+	glGetProgramiv(spec->id, GL_COMPLETION_STATUS_KHR, &done);
+	if (done == GL_FALSE) {
+		RenderingServerDefault::redraw_request();
+		return nullptr;
+	}
+	spec->build_queued = false;
+	_finish_specialization(*spec, p_variant, p_version, p_specialization);
+	return spec;
+}
