 GLManagerEmbedded::GLManagerEmbedded() {
-	display_semaphore = dispatch_semaphore_create(BUFFER_COUNT);
+	// libdispatch aborts when it frees a semaphore whose value is below the value that created it. The swaps that wait
+	// for the display link leave this one below BUFFER_COUNT when the display link stops first, as it does when VSync
+	// turns off, so it starts at 0 and gets its BUFFER_COUNT buffers as signals.
+	display_semaphore = dispatch_semaphore_create(0);
+	for (uint32_t i = 0; i < BUFFER_COUNT; i++) {
+		dispatch_semaphore_signal(display_semaphore);
+	}
 
 	create_display_link();
 
