@@ -2332,16 +2332,81 @@ void RenderingDeviceDriverMetal::command_trace_rays(CommandBufferID p_cmd_buffer
 
 // ----- TIMESTAMP -----
 
+// Metal command buffers sample GPU timestamps only at the start and end of passes on Apple GPUs, so a query reads the
+// pass timeline of its command buffer (MDPassTimeline); results are in nanoseconds.
+
+MTL::CounterSampleBuffer *RenderingDeviceDriverMetal::new_timestamp_sample_buffer(uint32_t p_sample_count) {
+	if (!timestamp_counters_checked) {
+		timestamp_counters_checked = true;
+		if (device->supportsCounterSampling(MTL::CounterSamplingPointAtStageBoundary)) {
+			NS::Array *sets = device->counterSets();
+			for (NS::UInteger i = 0; sets != nullptr && i < sets->count(); i++) {
+				MTL::CounterSet *set = sets->object<MTL::CounterSet>(i);
+				if (set->name()->isEqualToString(MTL::CommonCounterSetTimestamp)) {
+					timestamp_counter_set = set;
+					timestamp_counter_set->retain();
+					break;
+				}
+			}
+		}
+	}
+	if (timestamp_counter_set == nullptr) {
+		return nullptr;
+	}
+	NS::SharedPtr<MTL::CounterSampleBufferDescriptor> desc = NS::TransferPtr(MTL::CounterSampleBufferDescriptor::alloc()->init());
+	desc->setCounterSet(timestamp_counter_set);
+	desc->setStorageMode(MTL::StorageModeShared);
+	desc->setSampleCount(p_sample_count);
+	NS::Error *error = nullptr;
+	MTL::CounterSampleBuffer *buffer = device->newCounterSampleBuffer(desc.get(), &error);
+	if (buffer == nullptr) {
+		// Without a sample buffer the queries read 0, as on devices that sample no timestamps.
+		timestamp_counter_set->release();
+		timestamp_counter_set = nullptr;
+	}
+	return buffer;
+}
