+/**************************************************************************/
+/*  wasd_engine_runtime.cpp                                               */
+/**************************************************************************/
+/* The WASD Engine runtime module, which WASD Engine's LibGodot builds add */
+/* to Godot (wasdengine/libgodot/patches in the WASD Engine repository).   */
+/**************************************************************************/
+
+#include "wasd_engine_runtime.h"
+
+#include "core/object/class_db.h"
+#include "core/object/script_language.h"
+#include "core/templates/local_vector.h"
+
+void WASDEngineRuntime::start_script_profiling(bool p_native_calls) {
+	for (int i = 0; i < ScriptServer::get_language_count(); i++) {
+		ScriptLanguage *language = ScriptServer::get_language(i);
+		language->profiling_set_save_native_calls(p_native_calls);
+		language->profiling_start();
+	}
+}
+
+void WASDEngineRuntime::stop_script_profiling() {
+	for (int i = 0; i < ScriptServer::get_language_count(); i++) {
+		ScriptServer::get_language(i)->profiling_stop();
+	}
+}
+
+Array WASDEngineRuntime::get_script_profile() const {
+	Array entries;
+	for (int i = 0; i < ScriptServer::get_language_count(); i++) {
+		ScriptLanguage *language = ScriptServer::get_language(i);
+		LocalVector<ScriptLanguage::ProfilingInfo> info;
+		int count = 0;
+		// A language writes at most the array's size; a full array may have left entries out, so a larger one asks again.
+		for (uint32_t size = 4096; size <= (1u << 22); size *= 2) {
+			info.resize(size);
+			count = language->profiling_get_accumulated_data(info.ptr(), int(size));
+			if (count < int(size)) {
+				break;
+			}
+		}
+		for (int j = 0; j < count; j++) {
+			const ScriptLanguage::ProfilingInfo &entry = info[j];
+			if (entry.call_count == 0) {
+				continue;
+			}
+			Array row = { String(entry.signature), int64_t(entry.call_count), int64_t(entry.total_time), int64_t(entry.self_time) };
+			entries.push_back(row);
+		}
+	}
+	return entries;
+}
+
+void WASDEngineRuntime::_bind_methods() {
+	ClassDB::bind_method(D_METHOD("start_script_profiling", "native_calls"), &WASDEngineRuntime::start_script_profiling);
+	ClassDB::bind_method(D_METHOD("stop_script_profiling"), &WASDEngineRuntime::stop_script_profiling);
+	ClassDB::bind_method(D_METHOD("get_script_profile"), &WASDEngineRuntime::get_script_profile);
+}
diff --git a/modules/wasd_runtime/wasd_engine_runtime.h b/modules/wasd_runtime/wasd_engine_runtime.h
new file mode 100644
index 0000000..06aa941
--- /dev/null
+++ b/modules/wasd_runtime/wasd_engine_runtime.h
@@ -0,0 +1,32 @@
+/**************************************************************************/
+/*  wasd_engine_runtime.h                                                 */
+/**************************************************************************/
+/* The WASD Engine runtime module, which WASD Engine's LibGodot builds add */
+/* to Godot (wasdengine/libgodot/patches in the WASD Engine repository).   */
+/**************************************************************************/
+
+#pragma once
+
+#include "core/object/object.h"
+#include "core/variant/array.h"
+
+/// Services of WASD Engine's LibGodot runtime for its harness script, as the engine singleton `WASDEngineRuntime`: the
+/// profilers of the script languages, which otherwise only a debugger starts.
+class WASDEngineRuntime : public Object {
+	GDCLASS(WASDEngineRuntime, Object);
+
+protected:
+	static void _bind_methods();
+
+public:
+	/// Clears and starts the profiler of every script language; with `p_native_calls`, a profile also lists the engine
+	/// methods that each function calls.
+	void start_script_profiling(bool p_native_calls);
+	/// Stops the profilers; the profile since the start stays readable.
+	void stop_script_profiling();
+	/// Returns one entry per function, or engine method a function called, that ran since profiling started:
+	/// [signature, calls, total microseconds, self microseconds]. A function's signature is
+	/// `<script path>::<line>::<function>`; an engine method's is `<script path>::0::<class>.<method>`, with the path
+	/// of the script whose function called it, and its self time is its total time.
+	Array get_script_profile() const;
+};
