+
+void initialize_wasd_runtime_module(ModuleInitializationLevel p_level) {
+	if (p_level != MODULE_INITIALIZATION_LEVEL_SCENE) {
+		return;
+	}
+	GDREGISTER_ABSTRACT_CLASS(WASDEngineRuntime);
+	wasd_engine_runtime = memnew(WASDEngineRuntime);
+	Engine::get_singleton()->add_singleton(Engine::Singleton("WASDEngineRuntime", wasd_engine_runtime));
+}
+
+void uninitialize_wasd_runtime_module(ModuleInitializationLevel p_level) {
+	if (p_level != MODULE_INITIALIZATION_LEVEL_SCENE) {
+		return;
+	}
+	Engine::get_singleton()->remove_singleton("WASDEngineRuntime");
+	memdelete(wasd_engine_runtime);
+	wasd_engine_runtime = nullptr;
+}
