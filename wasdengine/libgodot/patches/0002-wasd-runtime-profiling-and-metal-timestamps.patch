+#pragma mark - Timestamps
+
+void MDCommandBuffer::timestamp_write(MDTimestampPool *p_pool, uint32_t p_index) {
+	if (!pass_timeline) {
+		MTL::CounterSampleBuffer *samples = device_driver->new_timestamp_sample_buffer(MDPassTimeline::MAX_PASSES * 2);
+		if (samples == nullptr) {
+			p_pool->queries[p_index] = {};
+			return;
+		}
+		pass_timeline = std::make_shared<MDPassTimeline>();
+		pass_timeline->samples = NS::TransferPtr(samples);
+	}
+	// A compute or blit pass stays open across commands; it ends here, so that its end is sampled before the timestamp.
+	if (type == MDCommandBufferStateType::Compute) {
+		_end_compute_dispatch();
+	} else if (type == MDCommandBufferStateType::Blit) {
+		_end_blit();
+	}
+	p_pool->queries[p_index] = { pass_timeline, pass_timeline->pass_count };
+}
+
+NS::UInteger MDCommandBuffer::_next_pass_sample() {
+	if (!pass_timeline || pass_timeline->pass_count >= MDPassTimeline::MAX_PASSES) {
+		return MTL::CounterDontSample;
+	}
+	return NS::UInteger(pass_timeline->pass_count++) * 2;
+}
+
+void MDCommandBuffer::_sample_render_pass(MTL::RenderPassDescriptor *p_desc) {
+	MTL::RenderPassSampleBufferAttachmentDescriptor *attachment = p_desc->sampleBufferAttachments()->object(0);
+	NS::UInteger start = _next_pass_sample();
+	if (start == MTL::CounterDontSample) {
+		attachment->setSampleBuffer(nullptr);
+		return;
+	}
+	attachment->setSampleBuffer(pass_timeline->samples.get());
+	attachment->setStartOfVertexSampleIndex(start);
+	attachment->setEndOfVertexSampleIndex(MTL::CounterDontSample);
+	attachment->setStartOfFragmentSampleIndex(MTL::CounterDontSample);
+	attachment->setEndOfFragmentSampleIndex(start + 1);
+}
+
+MTL::ComputeCommandEncoder *MDCommandBuffer::_new_compute_encoder() {
+	NS::UInteger start = _next_pass_sample();
+	if (start == MTL::CounterDontSample) {
+		return command_buffer()->computeCommandEncoder(MTL::DispatchTypeConcurrent);
+	}
+	NS::SharedPtr<MTL::ComputePassDescriptor> desc = NS::TransferPtr(MTL::ComputePassDescriptor::alloc()->init());
+	desc->setDispatchType(MTL::DispatchTypeConcurrent);
+	MTL::ComputePassSampleBufferAttachmentDescriptor *attachment = desc->sampleBufferAttachments()->object(0);
+	attachment->setSampleBuffer(pass_timeline->samples.get());
+	attachment->setStartOfEncoderSampleIndex(start);
+	attachment->setEndOfEncoderSampleIndex(start + 1);
+	return command_buffer()->computeCommandEncoder(desc.get());
+}
+
+MTL::BlitCommandEncoder *MDCommandBuffer::_new_blit_encoder() {
+	NS::UInteger start = _next_pass_sample();
+	if (start == MTL::CounterDontSample) {
