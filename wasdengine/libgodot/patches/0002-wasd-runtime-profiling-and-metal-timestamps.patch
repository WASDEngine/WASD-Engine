+#pragma mark - MDPassTimeline
+
+void MDPassTimeline::_resolve() {
+	resolved = true;
+	uint32_t count = pass_count * 2;
+	times.resize(count);
+	if (count == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		times[i] = 0;
+	}
+	NS::AutoreleasePool *pool = NS::AutoreleasePool::alloc()->init();
+	NS::Data *data = samples ? samples->resolveCounterRange(NS::Range(0, count)) : nullptr;
+	if (data != nullptr && data->length() >= count * sizeof(MTL::CounterResultTimestamp)) {
+		const MTL::CounterResultTimestamp *results = static_cast<const MTL::CounterResultTimestamp *>(data->mutableBytes());
+		// The GPU timestamps of Apple GPUs count nanoseconds on the host clock of the command buffer's GPU start and end
+		// times. A sample outside them is left over from an earlier use of the sample buffer, so it is not taken.
+		uint64_t earliest = 1;
+		uint64_t latest = UINT64_MAX;
+		if (command_buffer) {
+			CFTimeInterval start = command_buffer->GPUStartTime();
+			CFTimeInterval end = command_buffer->GPUEndTime();
+			if (start > 0 && end >= start) {
+				earliest = uint64_t(start * 1e9) - MIN(uint64_t(start * 1e9), uint64_t(1000000));
+				latest = uint64_t(end * 1e9) + 1000000;
+			}
+		}
+		for (uint32_t i = 0; i < count; i++) {
+			uint64_t time = results[i].timestamp;
+			if (time != MTL::CounterErrorValue && time >= earliest && time <= latest) {
+				times[i] = time;
+			}
+		}
+	}
+	pool->release();
+	samples.reset();
+	command_buffer.reset();
+}
+
+uint64_t MDPassTimeline::time_after(uint32_t p_passes) {
+	if (!resolved) {
+		_resolve();
+	}
+	uint64_t time = 0;
+	for (uint32_t pass = 0; pass < MIN(p_passes, pass_count); pass++) {
+		time = MAX(time, times[pass * 2 + 1]);
+	}
+	if (time != 0) {
+		return time;
+	}
+	for (uint32_t pass = p_passes; pass < pass_count; pass++) {
+		if (times[pass * 2] != 0) {
+			return times[pass * 2];
+		}
+	}
+	return 0;
+}
