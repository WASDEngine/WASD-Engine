+	MTL::BlitPassSampleBufferAttachmentDescriptor *attachment = desc->sampleBufferAttachments()->object(0);
+	attachment->setSampleBuffer(pass_timeline->samples.get());
+	attachment->setStartOfEncoderSampleIndex(start);
+	attachment->setEndOfEncoderSampleIndex(start + 1);
+	return command_buffer()->blitCommandEncoder(desc.get());
+}
