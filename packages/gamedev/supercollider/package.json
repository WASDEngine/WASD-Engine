{
  "name": "@deepseek-ai/dsh-supercollider",
  "description": "Headless SuperCollider for the agent: an MCP server that designs sounds with sclang and renders them offline with scsynth",
  "version": "0.1.0-rc",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/gamedev/supercollider"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "sc/*.sc",
    "lib/types/**/*.d.ts"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@deepseek-ai/dsh-app-mcp": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-mcp-manager": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-mcp-manager": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0"
  }
}
