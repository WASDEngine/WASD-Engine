[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://wasd_smoke/smoke.gd" id="1"]
[ext_resource type="Script" path="res://addons/godot_state_charts/state_chart.gd" id="2"]
[ext_resource type="Script" path="res://addons/godot_state_charts/parallel_state.gd" id="3"]
[ext_resource type="Script" path="res://addons/godot_state_charts/compound_state.gd" id="4"]
[ext_resource type="Script" path="res://addons/godot_state_charts/atomic_state.gd" id="5"]
[ext_resource type="Script" path="res://addons/godot_state_charts/transition.gd" id="6"]
[ext_resource type="Script" path="res://addons/godot_state_charts/expression_guard.gd" id="7"]

[sub_resource type="Resource" id="HasAmmo"]
script = ExtResource("7")
expression = "ammo > 0"

[node name="Smoke" type="Node"]
script = ExtResource("1")

[node name="StateChart" type="Node" parent="."]
script = ExtResource("2")
initial_expression_properties = {
"ammo": 0
}

[node name="Root" type="Node" parent="StateChart"]
script = ExtResource("3")

[node name="Movement" type="Node" parent="StateChart/Root"]
script = ExtResource("4")
initial_state = NodePath("Idle")

[node name="Idle" type="Node" parent="StateChart/Root/Movement"]
script = ExtResource("5")

[node name="OnMove" type="Node" parent="StateChart/Root/Movement/Idle"]
script = ExtResource("6")
to = NodePath("../../Walking")
event = &"move"
delay_in_seconds = "0.0"

[node name="Walking" type="Node" parent="StateChart/Root/Movement"]
script = ExtResource("5")

[node name="OnStop" type="Node" parent="StateChart/Root/Movement/Walking"]
script = ExtResource("6")
to = NodePath("../../Idle")
event = &"stop"
delay_in_seconds = "0.0"

[node name="Weapon" type="Node" parent="StateChart/Root"]
script = ExtResource("4")
initial_state = NodePath("Holstered")

[node name="Holstered" type="Node" parent="StateChart/Root/Weapon"]
script = ExtResource("5")

[node name="OnDraw" type="Node" parent="StateChart/Root/Weapon/Holstered"]
script = ExtResource("6")
to = NodePath("../../Drawn")
event = &"draw"
guard = SubResource("HasAmmo")
delay_in_seconds = "0.0"

[node name="Drawn" type="Node" parent="StateChart/Root/Weapon"]
script = ExtResource("5")

[node name="AutoHolster" type="Node" parent="StateChart/Root/Weapon/Drawn"]
script = ExtResource("6")
to = NodePath("../../Holstered")
delay_in_seconds = "0.2"
