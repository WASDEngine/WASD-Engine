{
  "id": "beehave",
  "title": "Beehave",
  "host": "godot",
  "version": "2.9.3",
  "summary": "Behavior trees for NPC and enemy AI, built from selector, sequence and decorator nodes with your own action and condition scripts and a shared blackboard.",
  "useWhen": "Enemies or NPCs need layered decisions such as patrol, chase, attack, flee and cooldowns that would become a tangle of if-statements or one large state machine script.",
  "avoidWhen": "An enemy has two or three simple behaviors; a short match statement in its script is easier to follow.",
  "tags": [
    "ai",
    "npc",
    "enemy",
    "behavior"
  ],
  "stages": [
    "prototype",
    "content"
  ],
