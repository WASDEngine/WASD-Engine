{
  "id": "ant-landscape",
  "title": "A.N.T. Landscape",
  "host": "blender",
  "version": "0.2.0",
  "summary": "Noise-based terrain: grid or sphere meshes from 19 noise types with seeds, height clamps, edge falloff and erosion; bake heights to a heightmap for Godot.",
  "useWhen": "A level needs hills, mountains, canyons, dunes or a small planet generated from noise, as a terrain mesh (.glb) or a heightmap image.",
  "avoidWhen": "Flat ground or a hand-shaped blockout: a plane or a few primitives are enough.",
