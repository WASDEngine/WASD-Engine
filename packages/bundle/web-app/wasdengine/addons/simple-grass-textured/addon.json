{
  "id": "simple-grass-textured",
  "title": "SimpleGrassTextured",
  "host": "godot",
  "version": "2.1.1",
  "category": "environment",
  "cue": "fields of textured grass that sway and part underfoot",
  "summary": "Dense textured grass as one MultiMesh: tufts placed from code, a wind that sways them, and an optional mode in which characters and objects push the grass aside.",
  "useWhen": "Ground needs thick grass, reeds, wheat, or flowers that sway in the wind: meadows, lawns, fields, and riverbanks in a 3D game, thousands of tufts in a couple of draw calls, in Web builds too.",
  "avoidWhen": "The ground is lite-terrain's, which raises its own grass; the plants are whole models such as bushes and trees, which protonscatter places; or the game is 2D.",
  "tags": [
    "grass",
    "foliage",
    "wind",
    "meadow",
    "multimesh",
    "environment",
    "3d",
    "flowers",
    "plants",
    "vegetation",
    "reeds",
    "wheat"
  ],
  "stages": [
    "content",
    "polish"
  ],
