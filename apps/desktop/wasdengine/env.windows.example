# WASD Engine Windows release settings, in place of upstream's apps/desktop/.env.windows.example.
# Copy to apps/desktop/.env.windows (Git ignored); .github/workflows/wasd-desktop-windows.yml does so on its runner.
# Values are not shell-expanded. Package with --unsigned: WASD Engine signs no Windows build yet.
DSH_DESKTOP_APP_ID=com.wasdengine.desktop
# Installed builds update from the newest GitHub release of WASDEngine/WASD-Engine, with no mandatory-update policy.
DSH_DESKTOP_AUTO_UPDATE_ENV=github
# Installer archive compression (0-9); lower values trade download size for packaging time.
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=7
