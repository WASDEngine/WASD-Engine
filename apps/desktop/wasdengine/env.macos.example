# WASD Engine notarized macOS release settings, in place of upstream's apps/desktop/.env.macos.example.
# Copy to apps/desktop/.env.macos (Git ignored) and fill in the values; wasdengine/FORK.md (Releases) runs the build.
# Values are not shell-expanded; quote a value that contains # or spaces. Paths may be absolute or relative to apps/desktop.
# The runtime folders WASD_LIBGODOT_DIR, WASD_SUPERCOLLIDER_DIR, and WASD_GIMP_DIR come from the shell, not this file.
DSH_DESKTOP_APP_ID=com.wasdengine.desktop
# WASD Engine has no update service, so the build carries no update feed and no mandatory-update policy.
DSH_DESKTOP_AUTO_UPDATE_ENV=none
# The certificate name after "Developer ID Application: ", such as Jane Doe (ABCDE12345), and its 10-character Team ID.
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
# The Developer ID Application certificate with its private key, exported from Keychain Access as a .p12 file, and the
# password chosen at export (an explicit empty value for an unencrypted file); not an Apple account password.
CSC_LINK=
CSC_KEY_PASSWORD=
# Notarization with an App Store Connect API key (Users and Access, Integrations, Keys): the .p8 file, Key ID, and Issuer ID.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
